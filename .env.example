# Development example only. Do not use these values in production.

POSTGRES_DB=routes_oubliees
POSTGRES_USER=routes_oubliees
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# Le profil dev injecte une identite locale factice a la place de Cloudflare Access :
# il ne doit jamais etre utilise sur un serveur. Le profil prod refuse de demarrer si
# le profil dev est actif en meme temps.
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
FRONTEND_PORT=4200

# Adresse d'ecoute Spring.
# Deploiement systemd sur l'hote : 127.0.0.1 (Nginx est le seul point d'entree).
# Deploiement en conteneur : 0.0.0.0, la publication du port restant sur le loopback.
SERVER_ADDRESS=127.0.0.1

ADMIN_BOOTSTRAP_EMAILS=admin@example.invalid
CF_ACCESS_ISSUER=https://example.cloudflareaccess.com
CF_ACCESS_AUDIENCE=example-audience-tag
CF_ACCESS_CERTS_URL=https://example.cloudflareaccess.com/cdn-cgi/access/certs
# Secret Bearer Home Assistant : 32 octets aleatoires encodes en base64url
# (43 caracteres), par exemple `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`.
# Laisse vide ici : aucune valeur utilisable ne doit etre versionnee. En production, la
# variable est obligatoire et le demarrage echoue si elle est absente, factice ou courte.
RADAR_HOME_ASSISTANT_TOKEN=

SITE_PUBLIC_URL=http://localhost:8088
SITE_TIMEZONE=Europe/Paris

# Stockage des medias televerses depuis l'administration.
MEDIA_STORAGE_PATH=./media
# Plafond d'un fichier televerse, en octets (5 Mio par defaut). Le conteneur servlet en
# derive sa propre limite : voir MediaUploadConfiguration. Penser a `client_max_body_size`
# cote Nginx, qui doit rester au moins aussi permissif.
MEDIA_MAX_UPLOAD_BYTES=5242880
