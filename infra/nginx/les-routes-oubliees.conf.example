server {
    listen 127.0.0.1:8088;
    server_name _;

    root /opt/les-routes-oubliees/current/frontend;
    index index.html;

    client_max_body_size 10m;
    server_tokens off;

    # Nginx n'herite les add_header du niveau superieur que si l'emplacement n'en declare
    # aucun. Tout emplacement qui pose son propre Cache-Control doit donc repeter ces quatre
    # en-tetes, sinon la reponse part sans politique de securite. Le cas le plus grave est
    # `location = /index.html` : `try_files` y redirige en interne toutes les routes de la
    # SPA, donc c'est le document HTML de chaque page qui perdrait sa CSP.
    #
    # Le domaine des tuiles figure dans `img-src` *et* dans `connect-src`. Les deux sont
    # necessaires : le service worker Angular intercepte toutes les requetes, y compris les
    # images, et les rejoue par `fetch()`, soumis a `connect-src`. Sans cette autorisation,
    # ngsw echoue et repond par sa 504 de synthese, et la carte du Radar reste vide.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    location = /api/radar/events {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # Publication de position Home Assistant : seul chemin exempte de Cloudflare Access.
    # Le corps utile fait quelques centaines d'octets ; la limite est volontairement
    # restreinte a ce seul emplacement et ne s'applique pas aux autres routes.
    #
    # Etant la seule surface joignable sans identite, ce chemin est aussi le seul plafonne
    # en debit : la zone est declaree dans lro-rate-limit.conf.example, a installer dans
    # /etc/nginx/conf.d/. `burst=10` absorbe la rafale de rattrapage qui suit une coupure
    # reseau de Home Assistant. Le 429 est servi par Nginx, donc hors contrat
    # application/problem+json : acceptable pour un endpoint machine.
    location = /api/integrations/home-assistant/radar/treasure-position {
        client_max_body_size 4k;
        limit_req zone=lro_home_assistant burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # Medias : seul chemin applicatif exempte de `no-store`. Une URL de media designe
    # toujours le meme octet (un UUID par fichier, jamais reecrit), et le service worker
    # refuse de conserver une reponse marquee `no-store` : sans cette exemption, la carte
    # revelee, les avatars et l'embleme disparaissent des que le reseau tombe.
    #
    # Aucun `Cache-Control` n'est pose ici : `add_header` ajoute sans remplacer l'en-tete
    # amont, et le client recevrait deux directives contradictoires. C'est le backend qui
    # decide, dans PublicMediaController.
    #
    # Le prefixe `^~` est defensif : il empeche toute expression reguliere ajoutee plus tard
    # de reprendre la main sur ce chemin et d'y reposer un `no-store`.
    location ^~ /media/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_set_header Authorization $http_authorization;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    # `/media/` est traite par l'emplacement precedent et ne parvient jamais ici.
    location ~ ^/api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
        proxy_set_header Authorization $http_authorization;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(self)" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://tile.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    }

    location /actuator/ {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }

    location ~ /\. {
        deny all;
    }
}
